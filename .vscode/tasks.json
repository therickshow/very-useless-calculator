{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "C: build active file (debug)",
            "command": "${fileDirname}/../library/.venv/bin/python.exe",
            "args": [
                "${fileDirname}/../library/scripts/build.py",
                "${file}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Warnings on, debug symbols. GTK flags added automatically when needed."
        },
        {
            "type": "shell",
            "label": "C: build active file (release)",
            "command": "${fileDirname}/../library/.venv/bin/python.exe",
            "args": [
                "${fileDirname}/../library/scripts/build.py",
                "${file}",
                "--release"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "Optimised. GUI programs drop their console window."
        },
        {
            "type": "shell",
            "label": "C: build and run",
            "command": "${fileDirname}/../library/.venv/bin/python.exe",
            "args": [
                "${fileDirname}/../library/scripts/build.py",
                "${file}",
                "--run"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "Build, then run the result."
        }
    ]
}
